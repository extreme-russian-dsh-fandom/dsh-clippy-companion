{
  "name": "@local/dsh-clippy-companion",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "A draggable companion inside the DSH chat area with switchable sprite packs (OpenClippy and a DOOM face pack).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "clippy",
    "doom",
    "companion",
    "presets"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/openclippy/*",
    "assets/doom/*",
    "tools/*",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
